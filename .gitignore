# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# editores
.idea/
.vscode/
*.swp
*~

# rascunhos de desenho: mockups HTML e as imagens que saem deles. Ficam no
# disco enquanto servem de referencia, mas nao entram no repositorio -- um
# mockup publicado e lido como se fosse o produto.
docs/*mock*.html
docs/settings-mockup.html
docs/gaps-mockup.html
docs/echoclassic-legacy-theme.html
docs/img/*-mock.png

# artefatos de trabalho
node_modules/
dist/
*.tgz
*.log
.loop-state.md

# material local de desenvolvimento e validacao
docs/
tests/
tools/
qa/

# backups gerados pelo INSTALL.sh e por copias manuais
*.backup-*
EchoClassic.backup-*
_to_delete/

# restos que o macOS deixa ao substituir arquivo em compartilhamento SMB
.smbdelete*

# caches Python das ferramentas
__pycache__/
*.pyc
