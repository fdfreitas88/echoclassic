<?xml version="1.0" encoding="utf-8"?>
<!--
  LMS extension repository descriptor.

  This is the published descriptor. <url> always points at the release asset on
  GitHub, never at a local path, and a QA build never lives here:
  tools/release.sh refuses any descriptor that still marks itself as one. 3.2.8
  reached the point of publication marked that way and aimed at a local file,
  which is the whole reason that gate exists.

  <url> points at a zip whose root contains the EchoClassic folder. <sha> is the
  exact SHA-1 of the file attached to the release:

      shasum -a 1 EchoClassic-3.2.9.zip

  tools/release.sh writes both, and refuses to finish if the recorded SHA-1 does
  not match the package it just built.

  Users add the raw URL of this file under
  Server Settings > Plugins > Additional repositories:

      https://raw.githubusercontent.com/fdfreitas88/echoclassic/main/repo.xml
-->
<extensions>
  <details>
    <title lang="EN">Echo Classic</title>
  </details>
  <plugins>
    <plugin name="EchoClassic" version="3.5.5" minTarget="8.0" maxTarget="*">
      <title lang="EN">Echo Classic</title>
      <desc lang="EN">A responsive classic iPad-style LMS interface with advanced library, queue, player, signal-path and optional DSP controls.</desc>
      <url>https://github.com/fdfreitas88/echoclassic/releases/download/v3.5.5/EchoClassic-3.5.5.zip</url>
      <link>https://github.com/fdfreitas88/echoclassic</link>
      <category>skin</category>
      <icon>https://raw.githubusercontent.com/fdfreitas88/echoclassic/main/EchoClassic/HTML/echoclassic/html/images/icon.svg</icon>
      <sha>d75c9ee527856086520e8c2395ad8aadea6dd1d2</sha>
      <creator>Felipe Freitas</creator>
    </plugin>
  </plugins>
</extensions>
