<?xml version="1.0" encoding="utf-8"?>
<!--
  Descritor de repositorio de extensoes do LMS.

  Este arquivo e o descritor publicado: a <url> aponta sempre para o asset da
  release no GitHub, nunca para um caminho local. Um candidato de QA nao mora
  aqui -- tools/release.sh recusa qualquer descritor que ainda se declare
  candidato privado, porque a 3.2.8 chegou pronta para publicar declarando-se
  um e apontando para um caminho local. Ver PUB-01.

  O <url> aponta para um zip que contem a pasta EchoClassic na raiz. O <sha> e
  o SHA-1 exato do arquivo anexado a release:

      shasum -a 1 EchoClassic-3.2.9.zip

  O usuario final adiciona a URL crua deste arquivo em
  Ajustes do servidor > Plugins > Repositorios adicionais:

      https://raw.githubusercontent.com/fdfreitas88/echoclassic/main/repo.xml
-->
<extensions>
  <details>
    <title lang="EN">Echo Classic</title>
    <title lang="PT">Echo Classic</title>
  </details>
  <plugins>
    <plugin name="EchoClassic" version="3.2.8" minTarget="8.0" maxTarget="*">
      <title lang="EN">Echo Classic</title>
      <title lang="PT">Echo Classic</title>
      <desc lang="EN">The iPad Music look of iOS 9, over your own library. Shows the native sample rate and bit depth of what actually reaches the DAC.</desc>
      <desc lang="PT">A aparencia do app Musica do iPad no iOS 9, sobre a sua biblioteca. Mostra a taxa nativa e a profundidade de bits do que realmente chega ao DAC.</desc>
      <url>https://github.com/fdfreitas88/echoclassic/releases/download/v3.2.8/EchoClassic-3.2.8.zip</url>
      <link>https://github.com/fdfreitas88/echoclassic</link>
      <category>skin</category>
      <icon>https://raw.githubusercontent.com/fdfreitas88/echoclassic/main/EchoClassic/HTML/echoclassic/html/images/icon.svg</icon>
      <sha>d3493a9a16a342ad625ac9b4eb5cc05126fb8512</sha>
      <creator>Felipe Freitas</creator>
    </plugin>
  </plugins>
</extensions>
