<?xml version="1.0"?>
<extension>
	<id>cfac2d7e-09a2-43e0-b234-52b2078a3721</id>
	<name>ECHOCLASSIC_SKIN</name>
	<module>Plugins::EchoClassic::Plugin</module>
	<version>3.3.0</version>
	<description>PLUGIN_ECHOCLASSIC_SKIN</description>
	<creator>Felipe Freitas</creator>
	<category>skin</category>
	<!-- Caminho servido pelo LMS: a pasta HTML/echoclassic do plugin vira
	     /echoclassic/ na raiz do servidor. -->
	<icon>echoclassic/html/images/icon.svg</icon>
	<optionsURL>plugins/EchoClassic/settings/basic.html</optionsURL>
	<homepageURL>https://github.com/fdfreitas88/echoclassic</homepageURL>
	<defaultState>enabled</defaultState>
	<type>2</type>
	<targetApplication>
		<id>Logitech Media Server</id>
		<minVersion>8.0</minVersion>
		<maxVersion>*</maxVersion>
	</targetApplication>
</extension>
